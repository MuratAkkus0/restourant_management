# Postgres connection used by Prisma. When running via docker-compose the
# host is the service name ("db"); when running the API locally against the
# dockerized db it is "localhost".
DATABASE_URL="postgresql://manegio:manegio@localhost:5433/manegio?schema=public"

# HTTP port the API listens on.
PORT=4000

# Comma-separated list of origins allowed to call this API with credentials.
CORS_ORIGIN="http://localhost:5173"

# Secrets used to sign JWTs. Generate real random values for anything beyond
# local development, e.g. `openssl rand -hex 32`.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Base URL the API is reachable at (used to build absolute upload URLs and
# the QR code target for the public menu).
API_PUBLIC_URL="http://localhost:4000"
# Base URL of the web app (used to build the public menu link embedded in
# generated QR codes).
WEB_PUBLIC_URL="http://localhost:5173"

NODE_ENV="development"
