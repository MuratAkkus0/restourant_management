rules_version = '2';

// Firestore security rules for RestoManage (Manegio).
//
// Threat this closes: the client previously wrote its own `role` into
// `usersCompanies/{uid}` with no server-side check, so any authenticated
// user could set their own role to "admin" and pass every client-side
// route guard. These rules make `usersCompanies` the sole authorization
// source it already is in the app, but enforce it from the server side:
// a user may only ever read/write their own membership doc, may only
// create an "admin" doc for a company they actually own, and can never
// change `role` or `companyId` again after creation.
//
// Known limitation: there is no invite/access-key verification in this
// codebase yet (see `RegisterAccessKeysFeaturesModels.d.ts`, which defines
// the types but is never wired to an implementation), so a signed-in user
// can still create a "personal"/"customer" membership against any existing
// company id. Closing that fully requires a real invite-token flow; until
// that exists, treat any personal/customer signup as unverified in the
// application layer.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerOfCompany(companyId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == request.auth.uid;
    }

    match /usersCompanies/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.role in ['admin', 'personal', 'customer'] &&
        (
          request.resource.data.role != 'admin' ||
          isOwnerOfCompany(request.resource.data.companyId)
        );

      // `role` and `companyId` are immutable after creation - the client can
      // never escalate its own role or hop to a different company.
      allow update: if isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.companyId == resource.data.companyId;

      allow delete: if false;
    }

    match /companies/{companyId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      match /admins/{userId} {
        allow read, write: if isSignedIn() &&
          (request.auth.uid == userId || isOwnerOfCompany(companyId));
      }

      match /personals/{userId} {
        allow read, write: if isSignedIn() &&
          (request.auth.uid == userId || isOwnerOfCompany(companyId));
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
