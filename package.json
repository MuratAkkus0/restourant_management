{
  "name": "manegio",
  "private": true,
  "version": "1.0.0",
  "description": "Manegio - multi-tenant QR menu SaaS for restaurants (monorepo)",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "pretypecheck": "pnpm --filter @manegio/shared build",
    "typecheck": "pnpm -r typecheck",
    "pretest": "pnpm --filter @manegio/shared build",
    "test": "pnpm -r test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "3.4.2"
  }
}
